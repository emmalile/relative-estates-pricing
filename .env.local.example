# Copy to .env.local and fill in. Never commit .env.local.
# In Vercel, set these under Project Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase > Project Settings > API > service_role.
# SERVER ONLY — this bypasses row level security entirely. Never prefix it
# with NEXT_PUBLIC_, and never import it into browser code. It is used by
# the public manufacturer form routes, which have no signed-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute links in notification emails, and as the OAuth
# redirect base. Must match the site URL configured in Supabase Auth.
NEXT_PUBLIC_APP_URL=https://app.relativeestates.com

# Resend — manufacturer submission notifications
RESEND_API_KEY=re_your_key
NOTIFY_EMAIL=emma@relativeestates.com

# Dropbox — project file index. Create the app at
# https://www.dropbox.com/developers/apps with scoped access to the full
# Dropbox, and grant account_info.read, files.metadata.read and
# files.content.read. Add /api/dropbox/callback on each deployed origin as
# a redirect URI.
#
# SERVER ONLY — these authorize the whole team's Dropbox. Never prefix
# either with NEXT_PUBLIC_.
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
